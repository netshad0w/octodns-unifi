#!/bin/bash

# Get current script path
SCRIPT_PATH="$( dirname -- "$( readlink -f -- "${0}"; )"; )"
# Activate OctoDNS Python venv
source "${SCRIPT_PATH}/common.sh"

set -o pipefail

PYPYRC="$HOME/.pypirc"
if [ ! -e "$PYPYRC" ]; then
    cat << EndOfMessage >&2
$PYPYRC does not exist, please create it with the following contents

[pypi]
  username = __token__
  password = [secret-token-goes-here]

EndOfMessage
    exit 1
fi

VERSION="$(grep "^__version__" "octodns_unifi/__init__.py" | sed -e "s/.* = '//" -e "s/'$//")"

# Build and validate the artifacts before tagging so a broken build can't
# leave a pushed tag with nothing on PyPI behind it
python -m build --sdist --wheel
twine check dist/*$VERSION.tar.gz dist/*$VERSION*.whl
git tag -s "v$VERSION" -m "Release $VERSION"
git push origin "v$VERSION"
echo "Tagged and pushed v$VERSION"
twine upload dist/*$VERSION.tar.gz dist/*$VERSION*.whl
echo "Uploaded $VERSION"
