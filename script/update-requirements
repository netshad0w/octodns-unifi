#!/bin/bash

# Get current script path
SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
# Activate OctoDNS Python venv
source "${SCRIPT_PATH}/common.sh"

# Pin the supported Python floor so a bare run can't drift back to EOL versions.
case " $* " in
  *" --python-versions"*) ;;
  *) set -- --python-versions=3.11,3.12,3.13,3.14 "$@" ;;
esac

proviso --header="# DO NOT EDIT THIS FILE DIRECTLY - use ./script/update-requirements" "$@"
